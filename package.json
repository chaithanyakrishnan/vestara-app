{
  "name": "vestara-app",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=@vestara/api",
    "dev:web": "npm run dev --workspace=@vestara/web",
    "dev": "concurrently -n api,web -c blue,green \"npm run dev:api\" \"npm run dev:web\"",
    "db:migrate": "npm run prisma:migrate --workspace=@vestara/api",
    "db:generate": "npm run prisma:generate --workspace=@vestara/api",
    "db:seed": "npm run prisma:seed --workspace=@vestara/api",
    "build": "npm run build --workspace=@vestara/shared && npm run build --workspace=@vestara/api && npm run build --workspace=@vestara/web",
    "postinstall": "prisma skills sync || exit 0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "prisma": "^8.0.0-rc.12",
    "typescript": "^5.5.4"
  }
}

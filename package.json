{
  "name": "vestara-app",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev:api": "pnpm --filter @vestara/api dev",
    "dev:web": "pnpm --filter @vestara/web dev",
    "dev": "concurrently -n api,web -c blue,green \"pnpm dev:api\" \"pnpm dev:web\"",
    "db:migrate": "pnpm --filter @vestara/api prisma:migrate",
    "db:generate": "pnpm --filter @vestara/api prisma:generate",
    "db:seed": "pnpm --filter @vestara/api prisma:seed",
    "build": "pnpm --filter @vestara/shared build && pnpm --filter @vestara/api build && pnpm --filter @vestara/web build"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "typescript": "^5.5.4"
  },
  "packageManager": "pnpm@9.7.0"
}

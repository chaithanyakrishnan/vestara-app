{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "strict": true,
    // Vite does the bundling; tsc here is a type-checker only. Without this it
    // emits a .js sibling next to every .tsx in src/ on each build.
    "noEmit": true
  },
  "include": ["src"]
}

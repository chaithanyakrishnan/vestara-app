# SQLite by default — a plain file, no database server to install or run.
# The file is created at apps/api/prisma/dev.db the first time you migrate.
DATABASE_URL="file:./dev.db"

# To use Postgres instead (optional, closer to a production setup), change
# provider = "sqlite" to "postgresql" in prisma/schema.prisma and point this
# at your instance instead, e.g.:
# DATABASE_URL="postgresql://vestara:vestara_dev_pw@localhost:5432/vestara?schema=public"

JWT_ACCESS_SECRET="change-me-dev-only-access-secret"
JWT_REFRESH_SECRET="change-me-dev-only-refresh-secret"
PORT=4000
CORS_ORIGIN="http://localhost:5173"
UPLOAD_DIR="./uploads"
# Leave unset to run the extraction service in MOCK mode (returns the
# hardcoded 4 Bears Casino sample extraction, no external calls).
ANTHROPIC_API_KEY=

# Leave unset to run e-signature sends in SIMULATED mode: envelopes are
# recorded locally and marked sent, but nothing is transmitted to DocuSign.
DOCUSIGN_ACCOUNT_ID=""
DOCUSIGN_INTEGRATION_KEY=""

{
  "name": "@vestara/api",
  "version": "0.1.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "postinstall": "node scripts/ensure-env.js",
    "dev": "node scripts/ensure-env.js && tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "prisma:generate": "node scripts/ensure-env.js && prisma generate",
    "prisma:migrate": "node scripts/ensure-env.js && prisma migrate dev --name init",
    "prisma:seed": "node scripts/ensure-env.js && tsx prisma/seed.ts",
    "prisma:studio": "node scripts/ensure-env.js && prisma studio",
    "verify:extraction": "tsx scripts/verify-mock-extraction.ts",
    "verify:plan-types": "tsx scripts/check-plan-types.ts",
    "verify:form-defaults": "tsx scripts/check-form-defaults.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.121.0",
    "@prisma/client": "^6.0.0",
    "@vestara/shared": "*",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.15",
    "prisma": "^6.0.0",
    "tsx": "^4.16.5",
    "typescript": "^5.5.4"
  }
}
